# readme-sync: README section -> code paths that make it true.
# Section names are matched case-insensitively as a prefix of a README heading.
# Globs are bash patterns matched against repo-relative paths; `*` crosses `/`.

[Main operations]
src/*/Queries/*
src/*/Mutations/*
src/*/Controllers/*
src/pages/*/actions.*

[Data]
src/*/Dtos/*
src/*/Migrations/*
src/*/Entities/*
src/*/Events/*

[Depends on]
src/*/Clients/*
src/*/Integrations/*
# package manifests are deliberately absent: a version bump is not a new dependency

[Settings]
appsettings*.json
manifest.json
src/*/Options/*

[Development]
Dockerfile*
Jenkinsfile
Makefile
.github/workflows/*
