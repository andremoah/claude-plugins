{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andremota/claude-skills/feature-estimate/schema/estimate.config.schema.json",
  "title": "feature-estimate config",
  "type": "object",
  "required": ["repos"],
  "properties": {
    "repos": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "oneOf": [{ "required": ["path"] }, { "required": ["url"] }],
        "properties": {
          "path": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "role": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "when"],
        "properties": {
          "name": { "type": "string" }, "when": { "type": "string" }, "why": { "type": "string" }
        }
      }
    },
    "multipliers": {
      "type": "object",
      "properties": {
        "experience": { "$ref": "#/$defs/numMap" },
        "familiarity": { "$ref": "#/$defs/numMap" },
        "flag_penalties": { "$ref": "#/$defs/numMap" }
      }
    },
    "unit": { "enum": ["days", "points"] },
    "reference_max_age_days": { "type": "integer", "minimum": 1 },
    "references_file": { "type": "string" }
  },
  "$defs": {
    "numMap": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
  }
}
